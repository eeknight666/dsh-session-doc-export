{
  "name": "@local/session-doc-export",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把 DSH 会话导出成人可读的 Markdown / HTML / JSON，可选附带工具轨迹",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
